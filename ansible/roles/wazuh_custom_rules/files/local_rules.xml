<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>

<group name="honeypot,h0neytr4p">
  <rule id="100003" level="10">
    <decoded_as>json</decoded_as>
    <field name="dest_port">443</field>
    <description>H0neytr4p: HTTPS scan detected from $(src_ip)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <rule id="100004" level="12">
    <decoded_as>json</decoded_as>
    <field name="request_method">POST</field>
    <description>H0neytr4p: POST request - possible exploit attempt from $(src_ip)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>
</group>

<group name="fortigate,firewall">

  <rule id="100010" level="10" frequency="3" timeframe="60">
    <if_matched_sid>81626</if_matched_sid>
    <description>FortiGate: Multiple successful admin SSH logins from $(srcip)</description>
    <group>fortigate,successful_admin_login,</group>
  </rule>


  <rule id="100020" level="12" frequency="3" timeframe="120">
    <if_matched_sid>81606</if_matched_sid>
    <same_srcip />
    <description>
      FortiGate: SSH brute force attack detected from $(srcip)
    </description>
    <group>fortigate,authentication_bruteforce,attack,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100021" level="12">
    <if_sid>81606</if_sid>
    <field name="reason">exceed_limit</field>
    <description>
      FortiGate: Admin login blocked after excessive failures
    </description>
    <group>fortigate,authentication_bruteforce,attack,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100022" level="14" frequency="2" timeframe="300">
    <if_matched_sid>81606</if_matched_sid>
    <same_srcip />
    <if_sid>81626</if_sid>
    <description>
      FortiGate: Successful SSH login after brute force attempts from $(srcip)
    </description>
    <group>fortigate,account_compromise,authentication_success_after_failure,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
   </rule>

   <rule id="100011" level="3">
     <if_group>fortigate</if_group>
     <field name="type" negate="yes">traffic</field>
     <description>FortiGate: $(type)/$(subtype) - $(logdesc)</description>
     <group>,fortigate_visibility,</group>
   </rule>

   <rule id="100013" level="3">
     <if_group>fortigate</if_group>
     <field name="type">traffic</field>
     <description>FortiGate: $(action) $(proto) $(srcip):$(srcport) -> $(dstip):$(dstport) [$(service)]</description>
     <group>,fortigate_visibility,</group>
   </rule>

</group>

<group name="tpot,honeypot,">


<!-- Cowrie SSH brute force -->

<rule id="100100" level="12">
    <decoded_as>json</decoded_as>
    <field name="eventid">cowrie.login.failed</field>
    <description>
        TPOT Cowrie SSH brute force attempt from $(src_ip)
    </description>
    <group>tpot,honeypot,ssh_bruteforce,</group>
    <mitre>
        <id>T1110</id>
    </mitre>
</rule>


<!-- Cowrie connection -->

<rule id="100101" level="8">
    <decoded_as>json</decoded_as>
    <field name="eventid">cowrie.session.connect</field>
    <description>
        TPOT Cowrie SSH/Telnet connection from $(src_ip)
    </description>
    <group>tpot,honeypot,</group>
</rule>


<!-- Dionaea exploit -->

<rule id="100102" level="12">
    <decoded_as>json</decoded_as>
    <field name="connection.type">accept</field>
    <description>
        TPOT Dionaea malicious connection from $(src_ip)
    </description>
    <group>tpot,honeypot,exploit_attempt,</group>
    <mitre>
        <id>T1190</id>
    </mitre>
</rule>


<!-- Heralding brute force -->

<rule id="100103" level="12">
    <decoded_as>json</decoded_as>
    <field name="num_auth_attempts" negate="yes">0</field>
    <description>
        TPOT Heralding authentication attack from $(source_ip)
    </description>
    <group>tpot,honeypot,brute_force,</group>
    <mitre>
        <id>T1110</id>
    </mitre>
</rule>


<!-- Cowrie successful login (basarisiz denemelerden cok daha kritik) -->

<rule id="100104" level="14">
    <decoded_as>json</decoded_as>
    <field name="eventid">cowrie.login.success</field>
    <description>
        TPOT Cowrie SSH/Telnet successful login from $(src_ip) as $(username)
    </description>
    <group>tpot,honeypot,authentication_success,attack,</group>
    <mitre>
        <id>T1078</id>
    </mitre>
</rule>

<!-- Cowrie file download yakalandi (saldirganin indirdigi/birakmaya calistigi dosya) -->
<rule id="100105" level="15">
    <decoded_as>json</decoded_as>
    <field name="eventid">cowrie.session.file_download</field>
    <description>
        TPOT Cowrie file download captured from $(src_ip)
    </description>
    <group>tpot,honeypot,file_download,attack,</group>
    <mitre>
        <id>T1105</id>
    </mitre>
</rule>

</group>

<group name="tpot,availability,">
  <rule id="100200" level="12">
    <program_name>tpot-watchdog</program_name>
    <description>TPOT Watchdog: T-Pot service is down, manual intervention needed (see full_log for details)</description>
    <group>service_down,</group>
  </rule>
</group>

<group name="misp,">
  <rule id="100600" level="3">
    <field name="integration">misp</field>
    <match>misp</match>
    <description>MISP integration event</description>
    <options>no_full_log</options>
  </rule>

  <rule id="100601" level="5">
    <if_sid>100600</if_sid>
    <field name="misp.status">^error$</field>
    <description>MISP - API error: $(misp.error)</description>
    <options>no_full_log</options>
    <group>misp_error,</group>
  </rule>

  <rule id="100602" level="12" ignore="3600">
    <if_sid>100600</if_sid>
    <field name="misp.status">^match$</field>
    <description>MISP - IoC match: $(misp.checked_ip) found in event $(misp.event_id) - category $(misp.category)</description>
    <options>no_full_log</options>
    <group>misp_alert,</group>
    <mitre>
      <id>T1071</id>
    </mitre>
  </rule>
  <rule id="100321" level="0">
    <if_sid>100013</if_sid>
    <field name="subtype">^local$</field>
    <description>FortiGate: Cihazin kendi rutin cikis trafigi (bastirildi)</description>
  </rule>

  <rule id="100320" level="0">
    <if_sid>100013</if_sid>
    <field name="policyname">^internal-to-wan$</field>
    <description>FortiGate: Rutin WAN cikis trafigi (bastirildi)</description>
  </rule>

  <rule id="110001" level="12">
    <if_sid>86600</if_sid>
    <decoded_as>json</decoded_as>
    <field name="msg">SUNNYDAY_CANARY</field>
    <field name="event_type">canary</field>
    <description>SunnyDay canary event</description>
  </rule>

  <rule id="110010" level="10">
    <match>key="sunnyday_audit"</match>
    <description>SunnyDay audit canary</description>
  </rule>

</group>


<group name="health_monitor,">

  <rule id="100300" level="3">
    <decoded_as>json</decoded_as>
    <field name="service">\.+</field>
    <field name="host">\.+</field>
    <description>Health Monitor: $(service)@$(host) durum: $(svc_status)</description>
  </rule>

  <rule id="100301" level="12">
    <if_sid>100300</if_sid>
    <field name="svc_status" negate="yes">^active$</field>
    <description>KRITIK: $(service)@$(host) servisi SAGLIKSIZ - durum: $(svc_status)</description>
    <group>health_down,</group>
  </rule>

</group>

<group name="suricata_severity,">

  <rule id="100310" level="0">
    <if_sid>86601</if_sid>
    <field name="alert.severity">^3$</field>
    <description>Suricata: Bilgilendirici seviye - bastirildi</description>
  </rule>

  <rule id="100311" level="6">
    <if_sid>86601</if_sid>
    <field name="alert.severity">^2$</field>
    <description>Suricata: Orta seviye - $(alert.signature)</description>
  </rule>

  <rule id="100312" level="10" ignore="3600">
    <if_sid>86601</if_sid>
    <field name="alert.severity">^1$</field>
    <description>Suricata: YUKSEK seviye - $(alert.signature)</description>
  </rule>

</group>

<group name="resource_monitor,">

  <rule id="100330" level="3">
    <decoded_as>json</decoded_as>
    <field name="check_kind">^resource$</field>
    <description>Kaynak izleme: $(res_name)@$(host) durum: $(svc_status) (deger: $(res_value))</description>
  </rule>

  <rule id="100331" level="8">
    <if_sid>100330</if_sid>
    <field name="svc_status">^warning$</field>
    <description>UYARI: $(res_name)@$(host) esik asildi - deger: $(res_value)</description>
    <group>resource_warning,</group>
  </rule>

  <rule id="100332" level="13">
    <if_sid>100330</if_sid>
    <field name="svc_status">^critical$</field>
    <description>KRITIK: $(res_name)@$(host) kritik esik asildi - deger: $(res_value)</description>
    <group>resource_critical,</group>
  </rule>

</group>



<group name="case_manager,">
  <rule id="100340" level="3">
    <decoded_as>json</decoded_as>
    <field name="case_id">\.+</field>
    <field name="case_status">\.+</field>
    <description>Vaka Yoneticisi: #$(case_id) - $(host) - $(rule_id) - durum: $(case_status)</description>
  </rule>
</group>
