[Unit]
Description=T-Pot
Wants=docker.service network-online.target
After=docker.service network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
TimeoutSec=infinity
ExecStartPre=-/usr/bin/docker compose -f /home/ubuntu/tpotce/docker-compose.yml down -v
ExecStart=/usr/bin/docker compose -f /home/ubuntu/tpotce/docker-compose.yml up
ExecStop=/usr/bin/docker compose -f /home/ubuntu/tpotce/docker-compose.yml down -v
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
