                "id": "8e08fcd4-2af2-4156-8b35-322994d29c10",
                "name": "MISP IP Gecmisini Sorgula",
                "type": "n8n-nodes-base.httpRequest",
                "typeVersion": 4.2,
                "position": [
                    -848,
                    -32
                ],
                "credentials": {
                    "httpHeaderAuth": {
                        "id": "pPT1pnT6E5Ny6t8A",
