            {
                "parameters": {
                    "jsCode": "const parsed = $('Parse ClickDetect Alert1').item.json;\nconst rule = parsed.rule;\nconst detector = parsed.detector;\nconst hits = parsed.hits;\nconst ipList = parsed.ipList;\nconst summaryLines = parsed.summaryLines;\n\n// MISP restSearch yanitini esnek sekilde oku\nlet searchResult = {};\ntry {\n  searchResult = $input.first().json || {};\n} catch (e) {\n  searchResult = {};\n}\nconst priorAttributes = (searchResult.response && searchResult.response.Attribute)\n  || searchResult.Attribute\n  || [];\nconst priorCount = Array.isArray(priorAttributes) ? priorAttributes.length : 0;\n\n// --- Genisletilmis IOC cikarma: detector turune gore farkli alanlar mevcut olabilir ---\nconst dstIps = new Set();\nconst ports = new Set();\nconst creds = new Set();\nconst hashes = new Set();\nconst urls = new Set();\n\nfor (const hit of hits) {\n  const d = hit.data || {};\n  if (d.dst_ip) dstIps.add(d.dst_ip);\n  if (d.dst_port) ports.add(String(d.dst_port));\n  if (d.username || d.password) creds.add(`${d.username || '?'} / ${d.password || '?'}`);\n  // Cowrie dosya indirme event'lerinde olabilecek alanlar (ileride file_download/malware_staging kurallari icin)\n  if (d.shasum) hashes.add(d.shasum);\n  if (d.url) urls.add(d.url);\n}\n\n// Bilinen MITRE technique ID'lerini okunabilir isme cevir (sadece su ana kadar gorulenler icin)\nconst techniqueNames = {\n  'attack.t1078': 'T1078 Valid Accounts (calinmis/tahmin edilmis gecerli kimlik bilgisiyle giris)',\n  'attack.t1105': 'T1105 Ingress Tool Transfer (arac/dosya indirme)',\n  'attack.t1110': 'T1110 Brute Force (kaba kuvvet deneme)',\n  'attack.t1133': 'T1133 External Remote Services (dis erisim servisi istismari)',\n  'attack.t1136.001': 'T1136.001 Create Account: Local Account (yeni yerel hesap olusturma)',\n  'attack.t1686.002': 'T1686.002 (savunma mekanizmasi degisikligi)'\n};\nconst readableTechniques = (rule.tags || [])\n  .filter(t => techniqueNames[t])\n  .map(t => `  - ${techniqueNames[t]}`)\n  .join('\\n');\n\nconst repeatComponent = Math.min(priorCount, 10) * 2;\nconst multiHitBonus = hits.length > 1 ? 5 : 0;\nlet score = (rule.level || 0) + repeatComponent + multiHitBonus;\n\n// Tuning (20 Temmuz vardiya bulgusu, 21 Temmuz duzeltmesi):\n// rule.level ClickDetect'in KENDI kural tanimindan geliyor (Wazuh'un ic\n// rule.level'inden FARKLI bir olcek - orn. bu Cowrie kurali icin 12,\n// Wazuh'un kendi 100104 kuralinda ise 14). Sayisal esik yerine, gercek\n// olay tipine (data.eventid) bakmak detector-bagimsiz ve dogru bir kontrol.\nconst isConfirmedSuccess = hits.some(h => (h.data && h.data.eventid) === 'cowrie.login.success');\nconst severityFloor = isConfirmedSuccess ? 15 : 0;\nscore = Math.max(score, severityFloor);\n\nlet riskLabel = 'Dusuk';\nlet shouldEmail = false;\nif (score >= 30) {\n  riskLabel = 'Kritik';\n  shouldEmail = true;\n} else if (score >= 15) {\n  riskLabel = 'Orta';\n  shouldEmail = true;\n}\n\n// --- MISP attribute'lerini olustur (artik daha fazla IOC turu) ---\nconst mispAttributes = ipList.map(ip => ({\n  type: 'ip-src', category: 'Network activity', value: ip,\n  comment: `ClickDetect: ${rule.name} | risk skoru: ${score} (${riskLabel})`, to_ids: true\n}));\ndstIps.forEach(ip => mispAttributes.push({\n  type: 'ip-dst', category: 'Network activity', value: ip,\n  comment: `Hedef sistem - ${rule.name}`, to_ids: false\n}));\nhashes.forEach(h => mispAttributes.push({\n  type: h.length === 64 ? 'sha256' : (h.length === 40 ? 'sha1' : 'md5'),\n  category: 'Payload delivery', value: h, to_ids: true\n}));\nurls.forEach(u => mispAttributes.push({\n  type: 'url', category: 'Payload delivery', value: u, to_ids: true\n}));\nif (creds.size > 0) {\n  mispAttributes.push({\n    type: 'text', category: 'Other',\n    value: `Denenen kimlik bilgileri: ${Array.from(creds).join(', ')}`, to_ids: false\n  });\n}\nmispAttributes.push({\n  type: 'text', category: 'Internal reference',\n  value: `ClickDetect rule ${rule.id} (${rule.name}) triggered ${hits.length} time(s) on detector \"${detector.name}\". Risk skoru: ${score} (${riskLabel}). Bu IP icin MISP'te ${priorCount} onceki kayit bulundu.`,\n  to_ids: false\n});\n\nconst eventTags = (rule.tags || []).map(t => ({ Tag: { name: t } }));\neventTags.push({ Tag: { name: `risk:${riskLabel.toLowerCase()}` } });\n\nconst threatLevel = score >= 30 ? '1' : (score >= 15 ? '2' : '3');\n\nconst mispEventBody = {\n  Event: {\n    info: `ClickDetect: ${rule.name} [Risk: ${riskLabel}, skor: ${score}]`,\n    distribution: '0', threat_level_id: threatLevel, analysis: '0',\n    EventTag: eventTags, Attribute: mispAttributes\n  }\n};\n\n// --- Daha aciklayici, bolumlere ayrilmis e-posta govdesi ---\nconst iocLines = [];\niocLines.push(`Kaynak IP(ler): ${ipList.join(', ') || 'yok'}`);\nif (dstIps.size) iocLines.push(`Hedef IP(ler): ${Array.from(dstIps).join(', ')}`);\nif (ports.size) iocLines.push(`Hedef port(lar): ${Array.from(ports).join(', ')}`);\nif (creds.size) iocLines.push(`Denenen kimlik bilgileri: ${Array.from(creds).join(', ')}`);\nif (hashes.size) iocLines.push(`Dosya hash'leri: ${Array.from(hashes).join(', ')}`);\nif (urls.size) iocLines.push(`URL'ler: ${Array.from(urls).join(', ')}`);\n\nconst emailSubject = `[${riskLabel}] ${rule.name} (skor: ${score}, ${ipList.length} kaynak IP)[ClickDetect]`;\n\nconst emailBody = `RISK SEVIYESI: ${riskLabel} (skor: ${score})\n\nNE OLDU?\n${rule.description}\n${readableTechniques ? '\\nIlgili MITRE ATT&CK teknikleri:\\n' + readableTechniques : ''}\n\nTESPIT EDILEN IOC'LER\n${iocLines.map(l => '  - ' + l).join('\\n')}\n\nBAGLAM\nDetector: ${detector.name} (tenant: ${detector.tenant})\nBu 5 dakikalik pencerede eslesme sayisi: ${hits.length}\nBu kaynak IP MISP'te daha once ${priorCount} kez gorulmus\n\nHAM OLAY KAYITLARI\n${summaryLines}\n\nRISK SKORU HESABI\n  Wazuh kural seviyesi: +${rule.level}\n  Tekrar gecmisi bonusu (max 10x2): +${repeatComponent}\n  Ciddiyet tabani (dogrulanmis basarili giris ise min. Orta garantisi): ${severityFloor > 0 ? '+uygulandi (taban ' + severityFloor + ')' : 'uygulanmadi'}\n  Ayni pencerede coklu eslesme bonusu: +${multiHitBonus}\n  TOPLAM: ${score}`;\n\nreturn [{ json: { mispEventBody, emailSubject, emailBody, ipList, score, riskLabel, shouldEmail } }];"
                },
